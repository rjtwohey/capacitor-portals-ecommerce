{
  "name": "enterprise-capacitor-portals",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ci:install": "corepack enable && corepack prepare pnpm@7.1.8 --activate && pnpm install --frozen-lockfile",
    "build:shell": "cross-env CAP_BUILD=true NX_INTERACTIVE=false nx run shell:build",
    "build": "cross-env CAP_BUILD=true NX_INTERACTIVE=false nx run-many --target=build --all",
    "serve": "cross-env NX_INTERACTIVE=false nx run-many --target=serve --all",
    "lint": "cross-env NX_INTERACTIVE=false nx run-many --target=lint --all",
    "fmt": "cross-env NX_INTERACTIVE=false nx run-many --target=fmt --all",
    "start": "cross-env NX_INTERACTIVE=false nx run-many --target=start --all",
    "reset": "find . -type dir -name node_modules | xargs rm -rf",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nx": "22.7.5",
    "typescript": "^6.0.3"
  },
  "author": "ionic-team",
  "packageManager": "pnpm@7.1.8"
}
