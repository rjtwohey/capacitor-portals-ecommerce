{
	"appId": "io.ionic.portals.ecommercewebapp",
	"appName": "Portals Web App",
	"webDir": "../shell/build",
	"plugins": {
		"LiveUpdate": {
			"appId": "d1024a49-c39a-4954-9664-68e7b905c593",
			"defaultChannel": "default",
			"readyTimeout": 10000
		},
		"FederatedCapacitor": {
			"shell": {
				"name": "shell",
				"liveUpdateConfig": {
					"providerId": "capawesome",
					"providerConfig": {
						"managerKey": "shell",
						"appId": "d1024a49-c39a-4954-9664-68e7b905c593",
						"channel": "default"
					},
					"autoUpdateMethod": "none"
				}
			},
			"apps": [
				{
					"name": "account",
					"webDir": "../account/build",
					"liveUpdateConfig": {
						"appId": "3fde24f8",
						"channel": "production",
						"autoUpdateMethod": "none",
						"strategy": "zip"
					}
				},
				{
					"name": "checkout",
					"webDir": "../checkout/build"
				},
				{
					"name": "helpinfo",
					"webDir": "../helpinfo/build"
				}
			]
		}
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"LiveUpdatePlugin",
		"CAPFederatedPlugin"
	]
}
